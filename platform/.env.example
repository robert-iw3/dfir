# IR Platform — environment. Copy to .env and adjust. Secrets never baked into images.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- PostgreSQL ---
POSTGRES_DB=ir_platform
POSTGRES_USER=ir_platform
POSTGRES_PASSWORD=ir_platform
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Object storage (MinIO local default; set S3_ENDPOINT_URL empty for real AWS S3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ir_platform
S3_SECRET_KEY=ir_platform_secret
S3_BUCKET=ir-evidence
S3_REGION=us-east-1
S3_USE_TLS=0

# --- Tamper-proof logging / custody signing (set these in prod) ---
IR_AUDIT_HMAC_KEY=dev-audit-hmac-key
IR_CUSTODY_HMAC_KEY=dev-custody-hmac-key

# --- Broker service token (deterministic so the broker can authenticate) ---
IR_BROKER_TOKEN=devbrokertoken0000000000000000000000000

# --- Demo role users (dev/UAT only; superseded by Keycloak SSO in the SSO overlay) ---
IR_SEED_DEMO_USERS=1
IR_ADMIN_PASSWORD=admin-demo-pw
IR_ANALYST_PASSWORD=analyst-demo-pw
IR_AUDITOR_PASSWORD=auditor-demo-pw

# --- SSO (H2: oauth2-proxy → Keycloak OIDC; used by docker-compose.sso.yml) ---
# Shared secret nginx sets on backend requests so the backend trusts the oauth2-proxy-forwarded
# identity (anti-spoofing). Backend enables SSO auth only when this is set.
IR_SSO_PROXY_SECRET=ir-sso-proxy-shared-secret
OAUTH2_PROXY_SECRET=ir-platform-oauth2-proxy-secret-32ch
OAUTH2_PROXY_APP_URL=https://127.0.0.1:8443
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
