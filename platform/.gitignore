# Secrets & local env
.env
# Tailnet pre-auth keys, minted per bring-up by tailnet_bootstrap.sh. Short-lived,
# but a key in git is a key an attacker can enrol a node with while it lives.
.env.tailnet
.env.*
!.env.example

# Test artifacts
test/evidence/
test/*.log

# TLS certs (self-signed, generated by traefik/gen-cert.sh)
traefik/certs/
# The receiver's key protects evidence confidentiality: anyone holding it can
# impersonate the receiver and be handed a host's memory image.
dmz/certs/
# Consul's CA, gossip key and ACL tokens. The management token rewrites any intention in
# the mesh; a service token re-registers that service.
hashicorp/consul/secrets/
# The control plane's key: whoever holds it can impersonate headscale, issue node keys,
# and sit in the middle of every relayed session.
hashicorp/access/certs/
# Rendered from templates and carrying Boundary's encryption roots and recovery key —
# whoever holds those can create a target and grant themselves a session into the enclave.
# The Boundary certificate and key live under hashicorp/access/certs/, above.
hashicorp/access/boundary-controller.hcl
hashicorp/access/boundary-egress.hcl

# Python
__pycache__/
*.pyc
backend/staticfiles/

# Node / frontend build
frontend/node_modules/
frontend/dist/
frontend/package-lock.json

# Rendered by deploy.sh from hashicorp/access/Corefile.tmpl
hashicorp/access/Corefile

# Reverse-engineering sessions. `stage_regions.sh` writes one host's carved regions here as
# real bytes from a real capture — memory contents of an investigated machine. They are
# evidence handled under custody in object storage, and a working tree is not custody.
re-workstation/session-*/
# Binary Ninja preferences, created per deployment by launch.sh.
re-workstation/binja-settings.json
