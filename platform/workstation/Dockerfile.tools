# Analyst-workstation test node: the edge network has no internet gateway, so diagnostic tools are
# baked in. Stand-in for an enrolled tailnet node, proving reachability to the broker and
# unreachability to everything internal.
FROM docker.io/library/alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache curl bind-tools netcat-openbsd python3
CMD ["sleep", "infinity"]
