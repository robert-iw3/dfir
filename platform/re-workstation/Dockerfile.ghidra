# Reverse-engineering workstation — Ghidra over carved memory regions; same containment as the
# Binary Ninja image (no network namespace, destroyed on exit), fetched at build time so a session
# needs no route out. Debian 13 for Java 21 (Ghidra 12 rejects 17), and the FULL JDK — the
# headless package omits AWT/Swing, so the GUI cannot start while analyzeHeadless still works,
# which hides the loss.
FROM docker.io/library/debian:13@sha256:d63a99144861e4e460196ed93d07777490cbeab53ca660c434f2a589a6c50ea3

ENV DEBIAN_FRONTEND=noninteractive

# glibc deliberately: Ghidra ships prebuilt decompiler natives linked against it, and musl would
# mean rebuilding them with the whole Gradle toolchain. A JDK, not a JRE — the launcher rejects a
# JRE-only install.
RUN groupadd -g 1001 ghidra \
    && useradd -u 1001 -g 1001 -m -s /bin/bash ghidra \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils locales unzip wget python3 \
        openjdk-21-jdk \
        libxrender1 libxtst6 libxi6 libxext6 libx11-6 libxcb1 \
        fontconfig fonts-dejavu-core \
    && sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && printf 'LANG=en_US.UTF-8\n' > /etc/default/locale \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Pinned by version AND digest. An unpinned build of a malware-analysis tool is a supply-chain
# question mark in the one container that opens live samples, and the hash is what makes a
# substituted archive fail the build instead of shipping.
ENV GHIDRA_VERSION=12.1.2_PUBLIC \
    GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/ghidra_12.1.2_PUBLIC_20260605.zip \
    GHIDRA_SHA=b62e81a0390618466c019c60d8c2f796ced2509c4c1aea4a37644a77272cf99d

RUN mkdir -p /regions \
    && wget -q --progress=bar:force -O /tmp/ghidra.zip "${GHIDRA_URL}" \
    && echo "${GHIDRA_SHA}  /tmp/ghidra.zip" | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && mv "/opt/ghidra_${GHIDRA_VERSION}" /ghidra \
    && chmod +x /ghidra/ghidraRun /ghidra/support/analyzeHeadless \
    && rm -f /tmp/ghidra.zip \
    # Nothing here should extend what the tool does, and an extension directory is one more
    # place a malicious sample could try to write into.
    && rm -rf /ghidra/docs /ghidra/licenses /ghidra/Extensions/Eclipse /ghidra/Extensions/Ghidra \
    && find /ghidra -type f -name '*src*.zip' -delete \
    && chown -R ghidra:ghidra /ghidra /regions

# Pin the JDK path: the launcher otherwise searches and then PROMPTS, and a container has no TTY,
# so every import aborts. In launch.properties, not ~/.ghidra — the session tmpfs over home would
# erase a path saved there.
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# The shipped file already carries an EMPTY `JAVA_HOME_OVERRIDE=` line, so appending a second
# one leaves two directives and the effective value depends on which the launcher reads. The
# existing line is REPLACED and the result asserted — a build-time smoke test cannot catch the
# ambiguity, because /root is writable during the build and the JDK search succeeds anyway.
RUN set -eu; \
    test -x "${JAVA_HOME}/bin/java"; \
    sed -i "s|^JAVA_HOME_OVERRIDE=.*|JAVA_HOME_OVERRIDE=${JAVA_HOME}|" \
        /ghidra/support/launch.properties; \
    grep -q "^JAVA_HOME_OVERRIDE=${JAVA_HOME}$" /ghidra/support/launch.properties \
      || { echo "JAVA_HOME_OVERRIDE was not set" >&2; exit 1; }; \
    test "$(grep -c '^JAVA_HOME_OVERRIDE=' /ghidra/support/launch.properties)" -eq 1 \
      || { echo "more than one JAVA_HOME_OVERRIDE directive — the effective value is ambiguous" >&2; exit 1; }

# Prove the launcher works, not just that its files exist: importing a real file through
# analyzeHeadless exercises the same path a session does, so a broken JDK, a missing native or an
# unusable loader fails the BUILD.
RUN set -eu; \
    tmp="$(mktemp -d)"; \
    head -c 4096 /dev/urandom > "${tmp}/smoke.bin"; \
    /ghidra/support/analyzeHeadless "${tmp}" smoke \
        -import "${tmp}/smoke.bin" \
        -processor x86:LE:64:default \
        -loader BinaryLoader -loader-baseAddr 0x400000 \
        -noanalysis > "${tmp}/out.log" 2>&1 \
      || { echo "analyzeHeadless failed to import:" >&2; tail -20 "${tmp}/out.log" >&2; exit 1; }; \
    grep -q 'ERROR REPORT\|Import failed' "${tmp}/out.log" \
      && { echo "analyzeHeadless reported an import error:" >&2; tail -20 "${tmp}/out.log" >&2; exit 1; }; \
    test -f "${tmp}/smoke.gpr" \
      || { echo "no project created despite a successful import" >&2; exit 1; }; \
    echo "ghidra headless import OK"; rm -rf "${tmp}"

COPY ghidra-session.sh /usr/local/bin/ghidra-session
RUN chmod +x /usr/local/bin/ghidra-session

USER ghidra
WORKDIR /ghidra
ENTRYPOINT ["/usr/local/bin/ghidra-session"]
