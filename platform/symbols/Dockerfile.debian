# ISF builder, Debian/Ubuntu family — runs outside the enclave where debug symbols are
# downloadable; only the resulting JSON is carried inward. The entrypoint tries debuginfod by
# build-id, then the ddebs archive; the base must match the TARGET release (ddebs pockets are
# keyed by codename), selected by the driver from the requisites' VERSION_ID.
ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg xz-utils binutils python3 dpkg-dev \
        elfutils debuginfod \
        ubuntu-dbgsym-keyring \
    && rm -rf /var/lib/apt/lists/*

# dwarf2json converts the DWARF in a debug vmlinux into Volatility's ISF format. It is a
# static Go binary, so the same build works regardless of the target distro.
ARG DWARF2JSON_VERSION=0.9.0
# No `|| true` on this chain: it would cover the download, the digest check and the smoke
# test alike, so a missing tool would ship as a successful build. The digest is required
# because this binary decides how every memory capture is interpreted.
ARG DWARF2JSON_SHA256
RUN curl -fsSL -o /usr/local/bin/dwarf2json \
      "https://github.com/volatilityfoundation/dwarf2json/releases/download/v${DWARF2JSON_VERSION}/dwarf2json-linux-amd64" \
    && test -n "${DWARF2JSON_SHA256}" \
    && echo "${DWARF2JSON_SHA256}  /usr/local/bin/dwarf2json" | sha256sum -c - \
    && chmod +x /usr/local/bin/dwarf2json \
    && dwarf2json --help >/dev/null 2>&1

# The ddebs archive is not configured by default; it carries the kernel debug symbols.
RUN . /etc/os-release \
    && printf 'deb http://ddebs.ubuntu.com %s main restricted universe multiverse\n\
deb http://ddebs.ubuntu.com %s-updates main restricted universe multiverse\n' \
        "${VERSION_CODENAME}" "${VERSION_CODENAME}" > /etc/apt/sources.list.d/ddebs.list

COPY acquire.sh lp_url.py /usr/local/bin/
RUN chmod +x /usr/local/bin/acquire.sh /usr/local/bin/lp_url.py

ENV DEBUGINFOD_URLS="https://debuginfod.ubuntu.com https://debuginfod.elfutils.org"

ENTRYPOINT ["/usr/local/bin/acquire.sh"]
