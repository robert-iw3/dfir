# ===========================================================================
# Unified deployment configuration — copy to .env per site. The four tiers deploy to DIFFERENT
# HARDWARE: on one host these resolve to container networks, on real hardware set the routed
# addresses from NETWORKING.md.

# Where the ENCLAVE's puller reaches the DMZ receiver (enclave dials OUT). HTTPS is not optional:
# a memory image carries every credential and key the host had in RAM, and the custody seal proves
# integrity, not confidentiality.
RECEIVER_URL=https://receiver:8090
# Where the DMZ broker forwards analyst sessions (DMZ --> enclave ingress).
ENCLAVE_INGRESS=traefik:443
# The analyst-facing port. The DISTRIBUTOR binds this; it is the only port the tailnet ACL
# admits (hashicorp/access/policy.hujson) and the only way to a brokered session.
BROKER_LISTEN=8443
# Independent Boundary sessions, one per loopback port from here upward, addressable only by the
# distributor in the bastion's namespace — one shared session is a fleet-wide failure domain.
# Egress workers bound the blast radius of a worker loss; they do not raise the setup rate.
BOUNDARY_EGRESS_WORKERS=3
BROKER_SESSION_BASE=18443
BROKER_SESSIONS=8
# New analyst connections accepted per second at the distributor; the fragile hop is each session
# client's connection setup, so this scales with neither sessions nor workers. Empty means 8.
BROKER_ACCEPT_RATE=
# App-tier concurrency: each gunicorn sync worker holds ONE in-flight request, so this is the
# number of simultaneous requests served. Size to (2 x cores) + 1; empty means 17 for the 8-core
# reference host.
IR_GUNICORN_WORKERS=

# The address EVERY tailnet node dials for the control plane, and the one its certificate must
# cover. Workstations are separate machines, so a real deployment sets the DMZ's hostname or
# routable IP; the container-name default works only for single-host validation.
HEADSCALE_ADDR=headscale:8080
HEADSCALE_URL=http://headscale:8080
# Published on the DMZ host so off-host workstations can reach the control plane and STUN.
HEADSCALE_PORT=8080
HEADSCALE_STUN_PORT=3478
# Pre-auth keys are minted by deploy.sh from headscale and written to .env.tailnet — they are
# short-lived and per-node, so they are not committed here.
RECEIVER_PORT=8090
# The single public origin: app, IdP login and the SSO callback are all path-routed here,
# so exactly one port is brokered at the DMZ boundary.
PLATFORM_PUBLIC_URL=https://ir-platform.local:8443
KEYCLOAK_PUBLIC_URL=https://ir-platform.local:8443
OAUTH2_COOKIE_SECRET=VrzlIvvOwHJz6eqF7N5JjVI-DWbgrX_pHxlg8nAmiSs=

# Every workstation issued a tailnet identity: each id becomes a node name, a compose project, and
# a pre-auth key. Two sharing an id are ONE node — the tunnel works for whichever registered last.
#   deploy.sh workstation ws-002   # list the id here first, then deploy.sh dmz for its key
IR_WS_IDS=analyst

# ---- analyst-side network (fixed, so DNS + broker are stable) -------------
RUNTIME_DNS_ZONE=dns.podman
EDGE_SUBNET=10.89.30.0/24
DMZLINK_SUBNET=10.89.0.0/24
DNS_EDGE_IP=10.89.30.53
ENCLAVE_SUBNET=10.89.1.0/24
# The pool the runtime allocates from when a container has no pinned address; it MUST NOT overlap
# the pinned block below, or an unpinned service takes a pinned address while its owner is down
# and that service can never start again. The failure reads as "IPAM error: address already
# allocated", far from this file.
ENCLAVE_DYNAMIC_RANGE=10.89.1.128/26
ENCLAVE_DNS_IP=10.89.1.53
# The tailnet control plane needs a FIXED address, not a name: tailscaled takes over
# /etc/resolv.conf when it starts, so a node cannot resolve its own control plane by
# container name — it then falls back to public DERP bootstrap, which the edge network
# deliberately cannot reach, and the node never logs in.
IR_PLATFORM_URL=https://ir-platform.local:8443/

# Each mesh service's registered address is STATED here, never discovered — a discovered address
# is stale the moment a container is recreated, and the failure surfaces far from the cause.
# Single host: the pinned container addresses below; multi-host: IR_MESH_ADDR_<SERVICE> (routable
# host address) takes precedence, with IR_MESH_MULTIHOST=1 and IR_MESH_PORT_<SVC> — see
# deploy/NETWORKING.md.
#   IR_MESH_ADDR_IR_POSTGRES=10.20.30.11 / IR_MESH_MULTIHOST=1 / IR_MESH_PORT_DB=21001
IR_IP_DB=10.89.1.201
IR_IP_MINIO=10.89.1.202
IR_IP_VAULT=10.89.1.203
IR_IP_BACKEND=10.89.1.204
IR_IP_WORKER=10.89.1.205
# Worker replica addresses take statics from .213 up (replica n at 211+n, ceiling .254 =
# 43 replicas on this bridge). Declared per replica as IR_IP_WORKERn; the overlay generator
# names the exact lines to add when IR_WORKER_REPLICAS needs more.
IR_IP_FRONTEND=10.89.1.206
IR_IP_PULLER=10.89.1.207
IR_IP_REDIS=10.89.1.208
IR_IP_OAUTH2_PROXY=10.89.1.209
IR_IP_LOG_SHIPPER=10.89.1.210
IR_IP_KEYCLOAK=10.89.1.211

# Smartcard (CAC/PIV) logon — OFF unless a real PKI is present (issuing CA, cards, revocation data
# staged in). Enabling it without trust anchors fails closed and locks every analyst out, so the
# deploy refuses that combination; see hashicorp/keycloak/pki-logon/README.md.
IR_PKI_LOGON=0

# ---- database -------------------------------------------------------------
POSTGRES_DB=ir_platform
# The static admin credential lives in .env.db (data tier only) — see that file.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- object store ---------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ir_platform
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=ir-evidence
S3_REGION=us-east-1
S3_USE_TLS=0

# ---- app secrets (Vault supplies these in a hardened deployment) ----------
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
IR_AUDIT_HMAC_KEY=CHANGE_ME
IR_CUSTODY_HMAC_KEY=CHANGE_ME
IR_BROKER_TOKEN=CHANGE_ME_40_CHARS
IR_SSO_PROXY_SECRET=CHANGE_ME

# ---- identity -------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Dev/UAT only — the realm's per-role break-glass logins. Disable in production.
IR_SEED_DEMO_USERS=1
IR_ADMIN_PASSWORD=admin-demo-pw
IR_ANALYST_PASSWORD=analyst-demo-pw
IR_AUDITOR_PASSWORD=auditor-demo-pw

# ---- analysis capacity ----------------------------------------------------
# How many memory-analysis workers the enclave runs, primary included. 1 is the default —
# one worker, as the platform has always run. Raising it stamps worker-2..N as identical
# consumers of the one analysis queue (each with its own scratch volume, mesh identity and
# health row), which is how a surge is drained in parallel: a SIEM flags a fleet, memory
# arrives from every host at once, and N workers take one capture each. Capped at 50 for
# this phase; past a single host, capacity comes from analysis hosts (Nomad), not replicas.
IR_WORKER_REPLICAS=1

# ---- correlation ----------------------------------------------------------
# HOW MANY MACHINES THE ESTATE HAS. Correlation asks what fraction of the fleet carries a
# given artifact — something on every host is the environment, something on two is why those
# two are being compared — so this is the denominator of every rarity it computes.
#
# Left unset it falls back to the number of hosts COLLECTED FROM, which is a different
# number and is wrong in the direction that hurts: three days into an engagement, with four
# machines collected, the C2 domain two of them share sits on half of everything the platform
# can see and scores as environment, so the two hosts an analyst most needs joined do not
# link. Declare the real figure; an estimate to the nearest hundred is fine.
# IR_DEPLOYMENT_HOSTS=5000

# ---- collection -----------------------------------------------------------
IR_INCIDENT_ID=INC-0001

# Carve ONLY regions with an indicator behind them. Set to 1 to carve every region a rule
# touches — a test aid for exercising the RE path, which buries the regions that matter among
# hundreds of benign ones.
IR_CARVE_ANY=0

# Which disassembler a session opens: binja or ghidra — the containment is identical, only the
# tool differs. `launch.sh --tool ghidra` overrides per session.
IR_RE_TOOL=binja

# Ghidra only: a carved region is raw memory with no header, so the processor must be declared.
# This platform collects Linux x86-64.
IR_GHIDRA_PROCESSOR=x86:LE:64:default
# Run auto-analysis on import. An imported-but-unanalyzed region shows bytes rather than code,
# which is the first thing an analyst would fix by hand.
IR_GHIDRA_ANALYSIS=1

# The analyst's hop into the enclave is a Boundary SESSION — bound to a principal, checked against
# one named target, auditable. Controller and egress worker both run in the ENCLAVE; the DMZ runs
# a session CLIENT only, with no route of its own.
BOUNDARY_HOST=boundary
BOUNDARY_EGRESS_HOST=boundary-egress
BOUNDARY_DB_PASSWORD=CHANGE-ME
# The principal the bastion's session client authenticates as. A session that cannot be
# attributed to an identity is indistinguishable from an unauthenticated forwarder.
BOUNDARY_ANALYST_LOGIN=analyst
BOUNDARY_ANALYST_PASSWORD=CHANGE-ME

# The platform authenticates as this principal to SHOW brokered sessions. It can list and
# read sessions and nothing else — watching access must not become a way to obtain it.
BOUNDARY_SESSION_AUDITOR_LOGIN=session-auditor
BOUNDARY_SESSION_AUDITOR_PASSWORD=change-me-session-auditor

# Boundary's encryption roots: RECOVERY authenticates provisioning with no account (deploy.sh uses
# it once), and WORKER_AUTH registers the egress worker with no approval step. The latter is
# acceptable only because both processes sit in the enclave.
BOUNDARY_ROOT_KEY=CHANGE-ME
BOUNDARY_WORKER_AUTH_KEY=CHANGE-ME
BOUNDARY_RECOVERY_KEY=CHANGE-ME
# The enclave ingress Boundary brokers to — the SSO gate, and the only target that exists.
IR_ENCLAVE_INGRESS_HOST=traefik
IR_ENCLAVE_INGRESS_PORT=443

# Source app secrets from Vault (dynamic Postgres credentials + KV) rather than this file; the
# values above become bootstrap admin credentials the application tier never sees. Set 0 to run
# without Vault.
IR_VAULT=1

# IR_MESH=1 registers each service with Consul and fronts it with an Envoy sidecar, so the
# intentions are ENFORCED at connect time rather than only written down. The bindings below ARE
# the enforcement — loopback makes the sidecar the only reachable listener; 0.0.0.0 with IR_MESH=0
# runs without the mesh, leaving segmentation only.
IR_MESH=1
IR_DB_LISTEN=127.0.0.1
IR_MINIO_LISTEN=127.0.0.1:9000
IR_REDIS_LISTEN=127.0.0.1
IR_DB_HOST_APP=127.0.0.1
IR_MINIO_ENDPOINT_APP=http://127.0.0.1:9000

# MULTI-HOST: a sidecar is co-located with its service, so off a single host only the address the
# rest of the mesh dials changes. Set one per service to that host's routable address; unset, it
# is discovered from the container (single-host validation).
#   IR_MESH_ADDR_IR_POSTGRES=10.20.30.11
#   IR_MESH_ADDR_IR_MINIO=10.20.30.12
#   IR_MESH_ADDR_IR_BACKEND=10.20.30.13

# Where a kiosk export lands ON THIS HOST — the kiosk filesystem is ephemeral, so without a host
# path the export dies with the container. Unset, deploy.sh resolves the platform's download
# directory and creates it; set it to pin one location.
#   IR_EXPORT_DIR=
