// Headscale ACL policy for the IR Platform — DENY BY DEFAULT: an analyst workstation may reach
// the bastion ONLY on the brokered frontend port. There are NO subnet routes in this design, so a
// workstation can never address an internal host directly.
{
  "acls": [
    {
      // The SSO-gated platform frontend (Traefik :443), brokered by the bastion. ONE port: the
      // bastion's N Boundary sessions listen on loopback behind the distributor, so a workstation
      // cannot choose or pin a session and re-create the shared failure domain.
      "action": "accept",
      "src": ["analyst@"],
      "dst": ["bastion@:8443"]
    },
    {
      // Boundary controller API + proxy — operator/DB access only, still brokered.
      "action": "accept",
      "src": ["operator@"],
      "dst": ["bastion@:9200", "bastion@:9202"]
    }
  ]
}
