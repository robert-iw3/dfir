# Connect sidecar — Envoy plus the Consul CLI: `consul connect envoy` fetches this service's mesh
# config, writes the bootstrap, and execs Envoy, so both binaries live in one image. Envoy 1.38
# per Consul 2.0.x support, with the compatibility check left ENABLED — a mismatched proxy fails
# in ways that read as policy.
FROM docker.io/hashicorp/consul:2.0.2@sha256:076f8ec1f45bfe2cedb5767d0692b68d775f9f76aca2f4d82caaf61fc9e36e47 AS consul

FROM docker.io/envoyproxy/envoy:v1.38.0@sha256:8146b97ee61a42cd216514709e4e3198af75f014974e3d9f310aef9c901fcbdf
COPY --from=consul /bin/consul /usr/local/bin/consul

# Envoy's image defaults to an entrypoint that assumes it is being handed Envoy flags. The
# sidecar is launched by the Consul CLI instead, which execs Envoy itself.
ENTRYPOINT []
CMD ["/bin/sh", "-c", "consul connect envoy --help"]
